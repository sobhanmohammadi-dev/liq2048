{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    { "name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "linux", "inherits": "base", "generator": "Ninja" },
    { "name": "macos", "inherits": "base", "generator": "Ninja" },
    { "name": "windows-vcpkg", "inherits": "base", "generator": "Visual Studio 17 2022",
      "cacheVariables": { "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake" } },
    { "name": "windows-fetch", "inherits": "base", "generator": "Visual Studio 17 2022",
      "cacheVariables": { "LIQ_FETCH_DEPS": "ON" } },
    { "name": "android-arm64", "inherits": "base", "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-24", "LIQ_FETCH_DEPS": "ON" } },
    { "name": "ios", "inherits": "base", "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS", "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0", "LIQ_FETCH_DEPS": "ON" } }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "windows-vcpkg", "configurePreset": "windows-vcpkg", "configuration": "Release" },
    { "name": "windows-fetch", "configurePreset": "windows-fetch", "configuration": "Release" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "ios", "configurePreset": "ios", "configuration": "Release" }
  ]
}
